POSTGRES_DB=salud_financiera
POSTGRES_USER=salud_financiera
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

DATABASE_URL=postgres://salud_financiera:change-me@localhost:5433/salud_financiera

# Login opcional (ver backend/.env.example, LOGIN_USERNAME/LOGIN_PASSWORD_HASH/
# SESSION_SECRET) — el frontend no necesita ninguna variable propia para esto: el token
# de sesión se guarda en el propio navegador tras iniciar sesión, no en el build.

# Solo hace falta en despliegues: fija la URL de la API en vez de deducirla del host
# desde el que se cargó la página (ver src/data/api.ts). En local/Tailscale, déjala vacía.
VITE_API_URL=
